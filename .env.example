# agent-core 环境变量模板
# 复制为 .env（已被 .gitignore 排除，永远不会提交）：
#   cp .env.example .env
#
# 必需：LLM API 密钥（DeepSeek，OpenAI 兼容端点）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 可选：Dashboard Bearer token 认证。
# 设置后 /api/* 需要 Authorization: Bearer <token>；不设置则 dev-mode 无需认证。
# AGENT_DASHBOARD_TOKEN=your-secret-token

# 可选：火山引擎实时语音面试（Dashboard「模拟面试」tab 实时语音模式）
# 缺任一密钥时实时语音自动禁用，文字面试不受影响。
# VOLC_APP_KEY=your-app-key
# VOLC_APP_ID=your-app-id
# VOLC_ACCESS_KEY=your-access-key
